rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ledgerDoc(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isMember(ledgerId) {
      return signedIn() && request.auth.uid in ledgerDoc(ledgerId).memberIds;
    }

    function onlyAddingSelfToMembers() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name == resource.data.name
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1;
    }

    match /users/{uid} {
      // Authenticated users can read profiles (member list on invite screen).
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['name', 'email']);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['ledgerId']);
      allow update, delete: if false;
    }

    match /ledgers/{ledgerId} {
      // IMPORTANT: avoid recursive read check on the same ledger doc.
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.keys()
            .hasAll(['name', 'ownerId', 'memberIds', 'inviteCode']);
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'name']))
        || onlyAddingSelfToMembers()
      );
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;

      match /transactions/{txId} {
        allow read: if isMember(ledgerId);
        allow create: if isMember(ledgerId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(ledgerId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(ledgerId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /categories/{catId} {
        allow read: if isMember(ledgerId);
        allow create: if isMember(ledgerId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(ledgerId)
          && resource.data.createdBy == request.auth.uid;
      }

      match /savingsGoals/{goalId} {
        allow read: if isMember(ledgerId);
        allow create: if isMember(ledgerId)
          && request.resource.data.createdBy == request.auth.uid;
        // Shared goal: any member may edit or archive it, not just the creator.
        allow update: if isMember(ledgerId);
        allow delete: if isMember(ledgerId);
      }

      match /savingsContributions/{contribId} {
        allow read: if isMember(ledgerId);
        allow create: if isMember(ledgerId)
          && request.resource.data.createdBy == request.auth.uid;
        // Contributions are immutable once written; corrections go through delete.
        allow update: if false;
        allow delete: if isMember(ledgerId)
          && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
